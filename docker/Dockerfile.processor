FROM --platform=$BUILDPLATFORM quay.io/projectquay/golang:1.27 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the go source
COPY cmd/batch-processor/ cmd/batch-processor/
COPY internal/ internal/
COPY pkg/ pkg/

# Build on the host architecture (BUILDPLATFORM) so the Go toolchain cross-compiles to
# TARGETARCH natively instead of running under QEMU.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -o bin/batch-gateway-processor ./cmd/batch-processor

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/bin/batch-gateway-processor /app/batch-gateway-processor
USER 65532:65532

ENTRYPOINT ["/app/batch-gateway-processor"]
